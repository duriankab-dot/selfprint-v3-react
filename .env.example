# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry Error Tracking
# Get DSN from: https://sentry.io/projects/YOUR_PROJECT/keys/
# Leave empty to disable error tracking in development
VITE_SENTRY_DSN=https://your-sentry-key@your-sentry-domain.ingest.sentry.io/your-project-id

# Anthropic API
# NOTE: ANTHROPIC_API_KEY is server-only (no VITE_ prefix) — it must NEVER be
# exposed to the browser bundle. Set it only in server/edge environment variables
# (Cloudflare Pages secret, Vercel env, or .env.local for local dev with server
# functions). Do NOT add a VITE_ANTHROPIC_API_KEY line here or in .env.local.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
