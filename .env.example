# ============================================================================
# SELFPRINT V3 — ENVIRONMENT VARIABLES
# ============================================================================
# ปรับปรุง 3 ก.ย. 2026 (ENVDOC-001) — ไฟล์เดิมขาด env ฝั่ง server ไปเกือบทั้งหมด
# และยังมีตัวแปรของ Vercel/backend ที่ถูกลบออกจากโปรเจกต์ไปแล้ว
#
# มี 2 กลุ่มที่ต้องแยกให้ขาด:
#   VITE_*  = build-time ของ Vite → **ถูกฝังลงบันเดิลที่เบราว์เซอร์โหลดได้**
#             ห้ามใส่ความลับเด็ดขาด
#   ไม่มี VITE_ = runtime ของ Cloudflare Pages Functions → ตั้งเป็น Secret
#             ใน CF dashboard เท่านั้น
#
# local dev: คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (.env* ถูก gitignore แล้ว)
# ============================================================================


# ─── ฝั่ง CLIENT (VITE_ — สาธารณะ ใครก็อ่านได้จากบันเดิล) ────────────────────

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry — เว้นว่างได้ ถ้าว่าง initializeSentry() จะข้ามไปเงียบ ๆ
VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Web Push (VAPID public key ตั้งใจให้เป็นสาธารณะ)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Staged rollout ของ AskCoach — ตอนนี้ต้องเป็น 0
# COACH404-001: /api/coach ยังไม่มี handler บน Cloudflare Pages
# ห้ามตั้งค่ามากกว่า 0 จนกว่าจะสร้าง functions/api/coach.ts เสร็จ
VITE_COACH_ROLLOUT_PERCENT=0

# Schema.org LocalBusiness (ใช้ใน JSON-LD)
VITE_BUSINESS_PHONE=+66-2-XXX-XXXX
VITE_BUSINESS_ADDRESS_STREET=Bangkok, Thailand
VITE_BUSINESS_ADDRESS_POSTAL=10110


# ─── ฝั่ง SERVER (Cloudflare Pages Functions — ตั้งเป็น Secret) ───────────────
# ⚠️ ทุกตัวด้านล่างนี้ห้ามมี prefix VITE_ เด็ดขาด

# Supabase — ENVNAME-001: โค้ดฝั่ง Functions อ่านชื่อพวกนี้ ไม่ใช่ VITE_*
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic — ใช้โดย functions/api/nova.ts และ functions/api/twin.ts
ANTHROPIC_API_KEY=your_anthropic_api_key

# เลือก model ได้ (ถ้าไม่ตั้ง จะใช้ค่า default ในโค้ด)
CLAUDE_MODEL_ID=
NOVA_MODEL_ID=
TWIN_MODEL_ID=

# Rate limit ต่อ IP ต่อนาที (default: nova 60, twin 40)
NOVA_RATE_LIMIT=60
TWIN_RATE_LIMIT=40

# CORS allowlist — CORS-ALLOWLIST-001
# คั่นด้วย comma; selfprint.one และ www.selfprint.one ถูกอนุญาตอยู่แล้วในโค้ด
ALLOWED_ORIGINS=

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PLUS_ANNUAL=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx

# URL ที่ Stripe จะ redirect กลับหลังจ่ายเงิน
FRONTEND_URL=https://selfprint.one


# ─── E2E TESTING (ใส่ใน .env.e2e.staging เท่านั้น ห้าม commit) ────────────────
# E2EPW-001: รหัสผ่านชุดเดิมเคย hardcode อยู่ใน e2e/fixtures/test-user.ts และ
# scripts/seed-test-users.ts ซึ่งถูก commit ลง repo สาธารณะ → หลุดไปแล้ว
# ต้องเปลี่ยนรหัสบัญชี staging ทุกตัวก่อนใช้งานต่อ
E2E_TEST_EMAIL=test-phase-b@selfprint.one
E2E_TEST_PASSWORD=
E2E_VOICE_PASSWORD=
E2E_TWIN_PASSWORD=
E2E_TECHBUDDY_PASSWORD=
E2E_MINDFULLEADER_PASSWORD=
E2E_CREATIVE_PASSWORD=
