{
  "buildCommand": "npm run build",
  "devCommand": "",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/stripe.ts": {
      "bodyParser": false
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
