{
  "name": "selfprint-v3-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:staging": "node e2e/run-staging.mjs",
    "supabase:resume": "ts-node scripts/supabase-lifecycle.ts resume",
    "supabase:pause": "ts-node scripts/supabase-lifecycle.ts pause",
    "supabase:status": "ts-node scripts/supabase-lifecycle.ts status",
    "supabase:resume-all": "ts-node scripts/supabase-lifecycle.ts resume-all",
    "supabase:pause-all": "ts-node scripts/supabase-lifecycle.ts pause-all",
    "e2e:with-supabase": "ts-node scripts/e2e-with-supabase.ts",
    "e2e:resume-only": "ts-node scripts/e2e-with-supabase.ts --resume-only",
    "e2e:pause-only": "ts-node scripts/e2e-with-supabase.ts --pause-only",
    "weekly:resume": "ts-node scripts/weekly-supabase-resume.ts",
    "seed:test-users": "ts-node scripts/seed-test-users.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@sentry/react": "^10.70.0",
    "@sentry/types": "^10.70.0",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.2",
    "stripe": "^16.12.0",
    "three": "0.186.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "supabase": "2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
