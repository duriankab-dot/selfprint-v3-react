{
  "$schema": "https://kilo.ai",
  
  // กำหนดสิทธิ์การเข้าถึงเครื่องมือ (Tool Permissions)
  "permissions": {
    "edit": [
      // อนุญาตให้แก้ไขไฟล์แผนงานและสถานะตามกฎในไฟล์ Master Rules
      { "action": "allow", "pattern": "plans/*.md" },
      { "action": "allow", "pattern": ".kilo/plans/*.md" },
      { "action": "allow", "pattern": "AI_WORK_STATE.md" },
      { "action": "allow", "pattern": "AI_ENTRYPOINT.md" }
    ]
  },

  // ผูกไฟล์กฎระเบียบที่คุณแนบมา เพื่อให้ AI อ่านและเชื่อฟังทุกครั้งก่อนเริ่มงาน
  "instructions": [
    "UNIVERSAL_MASTER_AI_RULES.md"
  ]
}
