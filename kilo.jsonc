{
  "$schema": "https://kilo.ai",

  // กำหนดสิทธิ์การใช้งาน Tools และการแก้ไขไฟล์
  "tools": {
    "edit": {
      "allow": [
        "plans/*.md",
        ".kilo/plans/*.md",
        "AI_WORK_STATE.md",
        "AI_ENTRYPOINT.md"
      ]
    }
  },

  // ผูกไฟล์กฎระเบียบและไฟล์ที่จำเป็น เพื่อให้ AI อ่านตาม BOOTSTRAP ORDER ก่อนเริ่มงานเสมอ
  "instructions": [
    "AI_ENTRYPOINT.md",
    ".clinerules",
    "UNIVERSAL_MASTER_AI_RULES.md",
    "AI_WORK_STATE.md"
  ]
}