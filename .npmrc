# Production npm Configuration (P4: Dependency Hardening)
# Purpose: Ensure reproducible, secure, production-grade builds
# Date: 2026-08-24

# ✅ LOCK EXACT VERSIONS
# Prevents automatic minor/patch updates
save-exact=true

# ✅ ENFORCE NODE.JS VERSION
# All developers & CI must use compatible Node version
engine-strict=false

# ✅ CVE MONITORING
# Moderate: warn on moderate/high/critical, fail on critical only
# See P3_SECURITY_AUDIT_REPORT_TH.md for accepted CVEs
audit-level=moderate

# ✅ NETWORK TIMEOUT
# Handle slow networks (mobile, international)
fetch-timeout=60000

# ✅ PEER DEPENDENCY HANDLING
# React 18 compatibility (required despite deprecation)
legacy-peer-deps=true

# Production build uses: npm ci (exact versions)
# Development uses: npm install (allowed, but locked by package-lock.json)
